Host *
  ForwardAgent no
  SetEnv TERM="xterm-256color"
  ServerAliveInterval 0
  ServerAliveCountMax 3
  Compression no
  AddKeysToAgent no
  HashKnownHosts no
  UserKnownHostsFile ~/.ssh/known_hosts
  ControlMaster no
  ControlPath ~/.ssh/master-%r@%n:%p
  ControlPersist no

Host gitlab.com
  IdentityFile /home/sanzo/.ssh/id_rsa

